<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<Version>1.1.2</Version>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>Constellation.Worker.xml</DocumentationFile>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Constellation Worker</Title>
		<Authors>Joel Christner</Authors>
		<Description>Constellation is RESTful workload placement and virtualization for exactly-one resource ownership patterns.  Constellation.Worker is the base class for worker nodes.</Description>
		<Copyright>(c)2026 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/constellation</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/constellation</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>rest workload placement virtualization sqlite</PackageTags>
		<PackageReleaseNotes>Fixed a lock-order deadlock between worker placement and worker removal, and the admin resource map returning lists shared with the live pool. Added REST_API.md and a Postman collection. See CHANGELOG.md.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\assets\logo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\LICENSE.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SyslogLogging" Version="2.3.1" />
		<PackageReference Include="WatsonWebsocket" Version="4.1.8" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Constellation.Core\Constellation.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Constellation.Worker.xml">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>

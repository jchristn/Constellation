        "y": 1
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "otel_scope_name": true,
              "otel_scope_version": true
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (component, operation, error_type) (increase(constellation_errors_total[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "format": "table",
          "instant": true
        }
